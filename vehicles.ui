  <property name="windowTitle"><string>Shongwe Motors - Vehicle Management</string></property>
  <widget class="QWidget" name="centralwidget"><property name="styleSheet"><string notr="true">QWidget#centralwidget { background-color: #F3F6F8; }
QFrame#frameHeader { background-color: #293742; border: none; }
QLabel#labelPageTitle { color: white; font-size: 22px; font-weight: bold; }
QLabel#labelLoggedUser { color: white; font-size: 12px; }
QGroupBox { background-color: white; border: 1px solid #D7E0E5; border-radius: 7px; margin-top: 11px; font-weight: bold; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 5px; }
QLineEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit { background-color: white; border: 1px solid #CCD6DB; border-radius: 4px; padding: 6px; }
QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QTimeEdit:focus { border: 2px solid #0789A6; }
QPushButton { min-height: 34px; padding: 5px 14px; border-radius: 4px; font-weight: bold; }
QPushButton#SaveButton { background-color: #0789A6; color: white; border: none; }
QPushButton#ClearButton, QPushButton#RefreshButton { background-color: white; color: #293742; border: 1px solid #AAB8BF; }
QPushButton#DeleteButton, QPushButton#ExitButton { background-color: #B84A4A; color: white; border: none; }
QPushButton#NextButton, QPushButton#BackButton { background-color: #293742; color: white; border: none; }
QPushButton#LogoutButton { background-color: transparent; color: white; border: 1px solid white; }
QTableWidget { background-color: white; border: 1px solid #D7E0E5; gridline-color: #E3E9EC; }
QHeaderView::section { background-color: #293742; color: white; padding: 6px; border: none; }</string></property>
